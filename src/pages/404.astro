---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/blog';
import PostList from '../components/PostList.astro';
const recent = (await getPosts()).slice(0, 3);
---
<BaseLayout title="Page not found" noindex>
  <div class="narrow page-head">
    <h1>This page doesn’t exist</h1>
    <p>The link may be old or mistyped. Try one of these instead.</p>
  </div>
  <div class="narrow">
    <p><a href="/">Home</a>, <a href="/blog/">all writing</a>, <a href="/projects/">projects</a>, or <a href="/contact/">contact</a>.</p>
    <h2 style="font-size: var(--step-1); margin: var(--space-6) 0 var(--space-3)">Recent writing</h2>
    <PostList posts={recent} />
  </div>
</BaseLayout>
