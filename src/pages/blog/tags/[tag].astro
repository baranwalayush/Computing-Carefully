---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`Articles tagged ${tag}.`}>
  <div class="narrow page-head">
    <h1>#{tag}</h1>
    <p>{posts.length} {posts.length === 1 ? 'article' : 'articles'}. <a href="/blog/">All writing</a></p>
  </div>
  <div class="narrow"><PostList posts={posts} showTags /></div>
</BaseLayout>
