---
import { profile, siteMeta } from '../data/profile';
---
<footer class="site-footer">
  <div class="container inner">
    <div>
      <p class="name">{profile.name}</p>
      <p class="meta">{profile.tagline}</p>
    </div>
    <ul class="links">
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      {profile.social.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
      <li><a href="/contact/">Contact</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <p class="meta copy">&copy; {siteMeta.copyrightYear} {profile.name}. All rights reserved.</p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--rule); margin-top: var(--space-7); padding-block: var(--space-6); }
  .inner { display: grid; gap: var(--space-5); grid-template-columns: 1fr auto; align-items: start; }
  .name { font-family: var(--font-serif); font-size: 1.1rem; margin: 0; }
  .site-footer p { margin: 0; }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-size: 0.92rem; }
  .links a { color: var(--text-muted); }
  .links a:hover { color: var(--text); }
  .copy { grid-column: 1 / -1; }
  @media (max-width: 40rem) { .inner { grid-template-columns: 1fr; } }
</style>
